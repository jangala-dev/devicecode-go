{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Pico (rp2040)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/devicecode.elf",
      "preLaunchTask": "TinyGo Build (rp2040)",
      "configFiles": [
        "debug/openocd_rp2040.cfg"
      ],
      "interface": "swd",
      "postLaunchCommands": ["monitor reset"]
    },
