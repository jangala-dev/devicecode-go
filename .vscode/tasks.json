{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "TinyGo Build (rp2040)",
      "type": "shell",
      "command": "tinygo",
      "args": [
        "build",
        "-o", "${workspaceFolder}/build/devicecode.elf",
        "-stack-size=3KB",
        "-serial=none",
        "-target=pico",
        "-tags", "pico_bb_proto_1",
        "-scheduler=tasks"
      ],
      "problemMatcher": []
    },
    {
      "label": "TinyGo Build (rp2350)",
      "type": "shell",
      "command": "tinygo",
      "args": [
        "build",
        "-o", "${workspaceFolder}/build/devicecode.elf",
        "-stack-size=8KB",
        "-serial=none",
        "-target=pico2",
        "-tags", "pico_bb_proto_1",
        "-scheduler=tasks"
      ],
      "problemMatcher": []
    }
  ]
}
